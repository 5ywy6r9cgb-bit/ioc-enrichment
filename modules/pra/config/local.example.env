# =====================================================================
# Sentinel Public Records Atlas v0.6.1 — LOCAL-ONLY configuration example
# Copy to `.env` (or `local.env`) on the operator's machine and edit.
# This file is an EXAMPLE. It contains no real secrets.
#
# v0.6.1 is local, single-operator only. No hosted DB, no remote DB,
# no public endpoint, no sync, no telemetry.
# =====================================================================

# --- Local Postgres (metadata only) ---
# Host MUST be localhost / 127.0.0.1 / ::1, or a Unix socket path.
# A remote/hosted host here is REJECTED by db_policy and the build fails review.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=sentinel_pra_v0_6_1
PGUSER=sentinel_app
PGPASSWORD=change_me_local_only
# TLS to a remote is N/A — there is no remote.
PGSSLMODE=disable

# --- Local service bridge ---
# The service binds ONLY to 127.0.0.1. Do not set an external address.
PRA_SERVICE_HOST=127.0.0.1
PRA_SERVICE_PORT=4317

# --- Browser-safety: approved local app origin(s), comma-separated ---
# CORS is disabled by default except for these origins. No wildcards.
PRA_ALLOWED_ORIGINS=http://127.0.0.1:4318,http://localhost:4318,null

# --- Least-privilege DB role (informational; grants are applied in psql) ---
# The app role should have SELECT/INSERT/UPDATE on metadata tables,
# INSERT-only on audit_ledger and export_ledger (append-only), and
# NO UPDATE/DELETE on the ledgers, NO superuser, NO DDL at runtime.

# --- v0.7 additions ---------------------------------------------------

# Where your received files actually live. RAW FILES NEVER ENTER THE
# DATABASE — this is only so the integrity checker knows where to look.
PRA_RECORDS_DIR=./Received_Records
PRA_MANIFEST_DIR=./manifests

# Backups (local only).
PRA_BACKUP_DIR=
PRA_BACKUP_RETAIN=30

# Who you are, for generated letters. Used only to fill {{requester_name}}
# and {{requester_contact}} placeholders. Never transmitted anywhere.
PRA_OPERATOR_NAME=
PRA_OPERATOR_CONTACT=

# The macOS account that owns the database (defaults to your username).
PRA_ADMIN_USER=
